{
  "mcpServers": {
    "dart": {
      "type": "stdio",
      "command": "fvm",
      "args": [
        "dart",
        "mcp-server"
      ],
      "env": {}
    },
    "firebase": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "firebase-tools@15.34.1",
        "mcp",
        "--dir",
        ".",
        "--only",
        "core,firestore,auth,crashlytics"
      ],
      "env": {}
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    }
  }
}